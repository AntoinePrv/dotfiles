// Zellij does not expand environment variables in layouts, so the cwd, and
// hence the project, comes from where zellij is started.
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="https://github.com/dj95/zjstatus/releases/download/v0.25.0/zjstatus.wasm" {
                format_left    "{mode}  {session}"
                format_center  "{tabs}▏"
                format_right   "{command_docker}{command_ssh}{datetime}"
                format_space   ""

                mode_normal          "#[bg=blue,fg=black] {name} "
                mode_locked          "#[bg=red,fg=black] {name} "
                mode_scroll          "#[bg=yellow,fg=black] {name} "
                mode_default_to_mode "normal"

                tab_normal "#[fg=white,bg=8]▏{name}{fullscreen_indicator}{floating_indicator}{sync_indicator} "
                tab_active "#[fg=black,bold,bg=white] {name} "
                tab_sync_indicator       " 󰓦"
                tab_fullscreen_indicator " 󰘖"
                tab_floating_indicator   " ⬚"

                datetime          "{format}"
                datetime_format   " %R   %a%e"
                datetime_timezone "Europe/Paris"

                command_docker_format   " {stdout}  "
                command_docker_command  "bash -c 'docker info &>/dev/null && docker context show'"
                command_docker_hideonemptystdout "true"
                command_docker_interval "10"
                command_docker_rendermode "static"

                command_ssh_format   " {stdout}  "
                command_ssh_command  "bash -c '[ -n \"${SSH_CLIENT}${SSH_TTY}\" ] && hostname -s'"
                command_ssh_hideonemptystdout "true"
                command_ssh_interval "3600"
                command_ssh_rendermode "static"
            }
        }
        children
        pane size=1 borderless=true {
            // TODO also add GH PR (done) and CI checks, and rebase status?
            // TODO notification
            // TODO pipes
            // TODO this create  lot of subprocess, a better approach could be to push all this
            // through pipe with a watchexec
            plugin location="https://github.com/dj95/zjstatus/releases/download/v0.25.0/zjstatus.wasm" {
                format_left  "{command_pixi}"
                format_right "{command_git_open}{command_git_status}{command_git_stashes}{command_git_ahead_behind}{command_gh_pr}{command_git_state}{command_git_branch}"
                format_space ""

                command_pixi_command    "bash -c '\"${ZELLIJ_CONFIG_DIR}/zellij-utils.sh\" pixi-envs'"
                command_pixi_cwd        "{focused_pane_cwd}"
                command_pixi_format     "#[fg=0,bg=2]  {stdout} #[fg=2,bg=default]"
                command_pixi_interval   "5"
                command_pixi_rendermode "static"
                command_pixi_hideonemptystdout "true"

                command_git_open_command    "git rev-parse --is-inside-work-tree"
                command_git_open_cwd        "{focused_pane_cwd}"
                command_git_open_format     "#[fg=8,bg=default]"
                command_git_open_interval   "1"
                command_git_open_rendermode "static"
                command_git_open_hideonemptystdout "true"

                // gh hits the network and takes seconds, hence the long interval
                command_gh_pr_command    "bash -c '\"${ZELLIJ_CONFIG_DIR}/zellij-utils.sh\" gh-pr'"
                command_gh_pr_cwd        "{focused_pane_cwd}"
                command_gh_pr_format     "#[fg=7,bg=8] {stdout} "
                command_gh_pr_interval   "30"
                command_gh_pr_rendermode "static"
                command_gh_pr_hideonemptystdout "true"

                command_git_branch_command   "bash -c '\"${ZELLIJ_CONFIG_DIR}/zellij-utils.sh\" git-branch'"
                command_git_branch_cwd        "{focused_pane_cwd}"
                command_git_branch_format     "#[fg=7,bg=8]  {stdout} "
                command_git_branch_interval   "1"
                command_git_branch_rendermode "static"
                command_git_branch_hideonemptystdout "true"

                command_git_state_command    "bash -c '\"${ZELLIJ_CONFIG_DIR}/zellij-utils.sh\" git-state'"
                command_git_state_cwd        "{focused_pane_cwd}"
                command_git_state_format     "#[fg=7,bg=8] {stdout} "
                command_git_state_interval   "1"
                command_git_state_rendermode "static"
                command_git_state_hideonemptystdout "true"

                command_git_status_command    "bash -c '\"${ZELLIJ_CONFIG_DIR}/zellij-utils.sh\" git-status'"
                command_git_status_cwd        "{focused_pane_cwd}"
                command_git_status_format     "#[fg=7,bg=8] {stdout} "
                command_git_status_interval   "1"
                command_git_status_rendermode "static"
                command_git_status_hideonemptystdout "true"

                command_git_stashes_command    "bash -c '\"${ZELLIJ_CONFIG_DIR}/zellij-utils.sh\" git-stashes'"
                command_git_stashes_cwd        "{focused_pane_cwd}"
                command_git_stashes_format     "#[fg=7,bg=8]  {stdout} "
                command_git_stashes_interval   "1"
                command_git_stashes_rendermode "static"
                command_git_stashes_hideonemptystdout "true"

                command_git_ahead_behind_command    "bash -c '\"${ZELLIJ_CONFIG_DIR}/zellij-utils.sh\" git-ahead-behind'"
                command_git_ahead_behind_cwd        "{focused_pane_cwd}"
                command_git_ahead_behind_format     "#[fg=7,bg=8] {stdout} "
                command_git_ahead_behind_interval   "1"
                command_git_ahead_behind_rendermode "static"
                command_git_ahead_behind_hideonemptystdout "true"
            }
        }
    }

    tab name="editor" focus=true {
        // Interactive shell so that the pvim function is defined
        pane borderless=true command="zsh" {
            args "-ic" "pvim; exec $SHELL"
        }
    }

    tab name="dev" {
        pane split_direction="vertical" {
            pane
            pane split_direction="horizontal" {
                pane
                pane
            }
        }
    }
}
