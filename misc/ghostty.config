# Colors
theme = "tinted-theming"

# Font
font-family = "FiraCode Nerd Font"
font-size = 15

# Window
fullscreen = true
window-padding-x = 0
window-padding-y = 0

# Mouse
mouse-hide-while-typing = true

# Keyboard — clear all defaults (splits, tabs, quick terminal, etc.)
macos-option-as-alt = true
keybind = clear
keybind = ctrl+v=paste_from_clipboard

# Keyboard — translated from alacritty
# Ctrl+Alt (CapsLock via Karabiner) for multiplexers because tmux cannot bind
# Super; switch to Super once tmux is no longer needed.
keybind = ctrl+v=paste_from_clipboard
keybind = shift+enter=text:\x1b\r
keybind = ctrl+alt+h=text:\x1b[104;7u
keybind = ctrl+alt+j=text:\x1b[106;7u
keybind = ctrl+alt+k=text:\x1b[107;7u
keybind = ctrl+alt+l=text:\x1b[108;7u
keybind = ctrl+alt+nine=text:\x1b[57;7u
keybind = ctrl+alt+zero=text:\x1b[48;7u
